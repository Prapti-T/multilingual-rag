# Copy to .env (git-ignored). Nothing here is a real credential.

# Required by `mlrag fetch` (Wikimedia User-Agent policy): an email or URL identifying you.
MLRAG_CONTACT=you@example.com

# Qdrant server (docker compose). Leave unset to use embedded local mode.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Only if embedding.provider / reranker.provider = cohere
# COHERE_API_KEY=

# Only if generation.provider = openai-compat (any OpenAI-compatible endpoint)
# LLM_BASE_URL=https://example.invalid/v1
# LLM_API_KEY=
# LLM_MODEL=
